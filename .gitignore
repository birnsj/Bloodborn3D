# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# OpenArt staging — track generation images + staging sidecar JSON; ignore job poll cache
.openart-staging/jobs/

# Meshy credentials + staging (API key must never be committed)
.meshy-credentials.json
.meshy-staging/

# Google Drive OAuth client + tokens (never commit)
.google-drive-oauth.json
.google-drive-tokens.json
.google-drive-oauth-pending-url.txt

# Google Drive image cache under Project Art
project-art/.bb-art/gdrive-cache/

# Atomic write temps from asset/concept middleware
**/.*.tmp
public/assets/.registry.json.*.tmp

# Concept Library images (Phase 2H.1D) — library.json is tracked; binary refs stay local
concept-library/images/

# Project Art Library — track artwork + .bb-art/library.json; ignore generated thumbs only
project-art/.bb-art/thumbs/**
!project-art/.bb-art/thumbs/.gitkeep

# Editor-local: track sticky notes + checklists with the project; ignore other local junk
.editor-local/*
!.editor-local/sticky-notes.json
!.editor-local/checklists.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
