# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# OpenArt PoC staging (Phase 2H.1A) — never commit generated downloads
.openart-staging/

# Atomic write temps from asset/concept middleware
**/.*.tmp
public/assets/.registry.json.*.tmp

# Concept Library images (Phase 2H.1D) — library.json is tracked; binary refs stay local
concept-library/images/

# Project Art Library — track .bb-art/library.json + empty dirs (.gitkeep); ignore binaries/thumbs
project-art/**/*.png
project-art/**/*.jpg
project-art/**/*.jpeg
project-art/**/*.webp
project-art/**/*.gif
project-art/**/*.PNG
project-art/**/*.JPG
project-art/**/*.JPEG
project-art/**/*.WEBP
project-art/**/*.GIF
project-art/.bb-art/thumbs/**
!project-art/.bb-art/thumbs/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
